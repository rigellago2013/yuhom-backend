generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User{
  id String @id @default(auto())  @map("_id") @db.ObjectId
  email String @unique
  password String
  role Role @default(USER)
  name String
  createdAt  DateTime  @default(now())  
  updatedAt  DateTime  @updatedAt
}

enum Role {
  USER
  ADMIN
}

model Hdmf{
    id String @id @default(auto())  @map("_id") @db.ObjectId
    rtn String
    housingAccountNumber Int
    lastName String
    firstName String
    nameExtension String
    middleName String
    citizenship String
    dateOfBirth DateTime
    placeOfBirth String
    maritalStatus String
    sex String
    positionAndDepartment String?
    businessTelNo String?
    pagibigMidRtn String
    tin Int?
    employer String?
    yearsInEmployment Int?
    employerBusinessAddress String?
    grossMonthlyIncome Int?
    educationalAttainment String?
    spouseRtn String
    spouseHousingAccountNumber Int
    spouseLastName String
    spouseFirstName String
    spouseNameExtension String
    spouseMiddleName String
    spouseCitizenship String
    spouseDateOfBirth DateTime
    spousePlaceOfBirth String
    spouseMaritalStatus String
    spouseSex String
    spousePositionAndDepartment String?
    spouseBusinessTelNo String?
    spousePagibigMidRtn String
    spouseTin Int?
    spouseEmployer String?
    spouseYearsInEmployment Int?
    spouseEmployerBusinessAddress String?
    spouseGrossMonthlyIncome Int?    
    createdAt  DateTime  @default(now())  
    updatedAt  DateTime  @updatedAt 
}


